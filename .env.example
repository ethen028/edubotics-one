# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/edubotics"
# Long random string used to sign login sessions (e.g. `openssl rand -base64 48`)
SESSION_SECRET=""
# Canonical staff app origin for secure recovery links. HTTPS, or localhost for local testing.
# APP_URL=https://one.example.com
# Public careers origin used by sitemap and social metadata. Never set it to the staff-only origin.
# PUBLIC_SITE_URL=https://jobs.example.com
# PUBLIC_CAREERS_HOST=jobs.example.com
# Internet deployment: enable both behind a controlled reverse proxy that overwrites forwarding headers.
# FORCE_HTTPS=true
# TRUST_PROXY_HEADERS=true
# Optional staged enforcement: first configure and test email and verify existing users.
# REQUIRE_VERIFIED_EMAIL=true
# Public careers in production requires CAPTCHA. Create a widget restricted to the public hostname.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# REQUIRE_CAPTCHA=true
# Vercel only: a long random value. Vercel sends it with the daily cron that sends automatic payment
# reminders (vercel.json); the office computer has its own timer and doesn't need it.
# CRON_SECRET=
# Optional: all Teamwork files (Files plus chat attachments) together, in MB. Default 2048.
# TEAMWORK_STORAGE_MB=2048
# Docker setup requires explicit credentials (use a long random hexadecimal DB password).
# DB_PASSWORD=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=
# For HTTPS gateway profile:
# APP_DOMAIN=one.example.com
# APP_BIND_ADDRESS=127.0.0.1
# Set to "false" only when serving over plain http on an office network (docker-compose.yml does this)
# COOKIE_SECURE="false"

# ─── Backups on the office computer (docker-compose.yml reads these; see docs/backups.md) ───
# Where daily backups are saved. Leave it out to use the "backups" folder next to docker-compose.yml.
# BACKUP_FOLDER=C:/Users/Ethen/Documents/Edubotics backups
# A second folder every backup is copied to: a synced Google Drive / OneDrive folder, or a drive
# that is always plugged in. Leave it out for no second copy.
# BACKUP_COPY_FOLDER=C:/Users/Ethen/My Drive/Edubotics backups
