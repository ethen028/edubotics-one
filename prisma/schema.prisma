generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Access ────────────────────────────────────────────────────────────────

enum Role {
  ADMIN // full access, manages users and HR records
  MANAGER // approves leave for their team
  EMPLOYEE
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(EMPLOYEE)
  active       Boolean   @default(true)
  employee     Employee?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  ownedLeads         Lead[]         @relation("LeadOwner")
  ownedOrganizations Organization[] @relation("OrgOwner")
  ownedContacts      Contact[]      @relation("ContactOwner")
  ownedDeals         Deal[]         @relation("DealOwner")
  activities         Activity[]     @relation("ActivityAssignee")
  createdActivities  Activity[]     @relation("ActivityCreator")
  uploadedDocuments  EmployeeDocument[] @relation("DocUploader")
  reviewedDocuments  EmployeeDocument[] @relation("DocReviewer")
  payrollRuns        PayrollRun[]
  ownedProjects      Project[]      @relation("ProjectOwner")
  projectMembers     ProjectMember[]
  assignedTasks      ProjectTask[]  @relation("TaskAssignee")
  createdTasks       ProjectTask[]  @relation("TaskCreator")
  decidedProjects    Project[]      @relation("ProjectApprover")
  decidedTimesheets  Timesheet[]    @relation("TimesheetApprover")
  coordinatedProgrammes Programme[]  @relation("ProgrammeCoordinator")
  programmeTrainers  ProgrammeTrainer[]
  trainerSessions    ProgrammeSession[] @relation("SessionTrainer")
  loggedSessions     ProgrammeSession[] @relation("SessionLogger")
}

// ─── HRM ───────────────────────────────────────────────────────────────────

model Department {
  id        String     @id @default(cuid())
  name      String     @unique
  employees Employee[]
  projects  Project[]
  createdAt DateTime   @default(now())
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum EmployeeStatus {
  ONBOARDING
  ACTIVE
  ON_NOTICE
  EXITED
}

model Employee {
  id               String         @id @default(cuid())
  code             String         @unique // e.g. EBG-001
  firstName        String
  lastName         String
  workEmail        String         @unique
  personalEmail    String?
  phone            String?
  designation      String
  departmentId     String?
  department       Department?    @relation(fields: [departmentId], references: [id])
  managerId        String?
  manager          Employee?      @relation("Reports", fields: [managerId], references: [id])
  reports          Employee[]     @relation("Reports")
  employmentType   EmploymentType @default(FULL_TIME)
  status           EmployeeStatus @default(ACTIVE)
  dateOfJoining    DateTime       @db.Date
  dateOfExit       DateTime?      @db.Date
  dateOfBirth      DateTime?      @db.Date
  gender           String?
  bloodGroup       String?
  address          String?
  city             String?
  state            String?        @default("Kerala")
  emergencyName    String?
  emergencyPhone   String?
  userId           String?        @unique
  user             User?          @relation(fields: [userId], references: [id])
  leaveRequests    LeaveRequest[] @relation("LeaveApplicant")
  approvedRequests LeaveRequest[] @relation("LeaveApprover")
  attendance       AttendanceSession[]
  attendanceMarks  AttendanceMark[]
  corrections      AttendanceCorrection[]
  onboardingTasks  OnboardingTask[]
  documents        EmployeeDocument[]
  assets           Asset[]
  trainings        TrainingAssignment[]
  salaries         SalaryStructure[]
  payslips         Payslip[]
  timesheets       Timesheet[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model LeaveType {
  id          String         @id @default(cuid())
  code        String         @unique // CL, SL, EL, LOP
  name        String
  annualQuota Float          @default(0) // days per calendar year; 0 = unlimited (e.g. LOP)
  paid        Boolean        @default(true)
  active      Boolean        @default(true)
  requests    LeaveRequest[]
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveRequest {
  id           String      @id @default(cuid())
  employeeId   String
  employee     Employee    @relation("LeaveApplicant", fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId  String
  leaveType    LeaveType   @relation(fields: [leaveTypeId], references: [id])
  startDate    DateTime    @db.Date
  endDate      DateTime    @db.Date
  halfDay      Boolean     @default(false)
  days         Float // working days, excluding Sundays and holidays
  reason       String
  status       LeaveStatus @default(PENDING)
  approverId   String?
  approver     Employee?   @relation("LeaveApprover", fields: [approverId], references: [id])
  decisionNote String?
  decidedAt    DateTime?
  createdAt    DateTime    @default(now())

  @@index([employeeId, startDate])
}

model Holiday {
  id       String   @id @default(cuid())
  date     DateTime @unique @db.Date
  name     String
  optional  Boolean  @default(false) // restricted holiday
  tentative Boolean  @default(false) // date depends on the moon or isn't notified yet
}

// ─── Company settings (single row, id = 1) ─────────────────────────────────

model CompanySettings {
  id                 Int   @id @default(1)
  workMinutesPerDay  Int   @default(540) // 9 hours, as in Edubotics HR V1.2
  overtimeAfterMins  Int   @default(30) // OD once a day runs this far past the target
  weeklyOffDays      Int[] @default([0, 6]) // 0 = Sunday … 6 = Saturday

  // Payroll. Deductions start switched off (Edubotics deducts none today).
  lopDivisor   Int     @default(30) // LOP per day = monthly gross ÷ this, as in HR V1.2
  pfEnabled    Boolean @default(false)
  esiEnabled   Boolean @default(false)
  ptEnabled    Boolean @default(false)
  tdsEnabled   Boolean @default(false)
}

// ─── Attendance ────────────────────────────────────────────────────────────

/// One check-in/check-out pair. A day can have several sessions.
model AttendanceSession {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workDate   DateTime  @db.Date // IST calendar date of the check-in
  checkIn    DateTime
  checkOut   DateTime?
  createdAt  DateTime  @default(now())

  corrections AttendanceCorrection[]

  @@index([employeeId, workDate])
}

enum AttendanceStatus {
  PRESENT
  INCOMPLETE // ID: worked less than the daily target
  OVERTIME // OD: worked past the target plus the overtime threshold
  ABSENT
  LEAVE
  MISPUNCH // checked in but never checked out
  HOLIDAY
  WEEKLY_OFF
}

/// HR/admin decision for a day that replaces the computed status.
model AttendanceMark {
  id         String           @id @default(cuid())
  employeeId String
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workDate   DateTime         @db.Date
  status     AttendanceStatus
  note       String?
  markedById String
  createdAt  DateTime         @default(now())

  @@unique([employeeId, workDate])
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Punch-out regularization: the employee forgot to check out.
model AttendanceCorrection {
  id                String            @id @default(cuid())
  employeeId        String
  employee          Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  sessionId         String
  session           AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  requestedCheckOut DateTime
  reason            String
  status            RequestStatus     @default(PENDING)
  decidedById       String?
  decidedAt         DateTime?
  createdAt         DateTime          @default(now())
}

// ─── Onboarding ────────────────────────────────────────────────────────────

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  NOT_APPLICABLE
}

model OnboardingTask {
  id         String     @id @default(cuid())
  employeeId String
  employee   Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title      String
  category   String // Documents, Admin, IT Setup, HR, Manager, Training
  dueDate    DateTime?  @db.Date
  status     TaskStatus @default(PENDING)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([employeeId])
}

// ─── Documents ─────────────────────────────────────────────────────────────

enum DocumentStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

/// Files live in Postgres so the app needs no separate storage service (5 MB cap each).
model EmployeeDocument {
  id           String         @id @default(cuid())
  employeeId   String
  employee     Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type         String // Aadhaar / ID proof, PAN card, Bank details, Offer letter…
  fileName     String
  mimeType     String
  size         Int
  data         Bytes
  status       DocumentStatus @default(PENDING)
  reviewNote   String?
  uploadedById String
  uploadedBy   User           @relation("DocUploader", fields: [uploadedById], references: [id])
  reviewedById String?
  reviewedBy   User?          @relation("DocReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  createdAt    DateTime       @default(now())

  @@index([employeeId])
}

// ─── Assets ────────────────────────────────────────────────────────────────

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  REPAIR
  RETIRED
}

model Asset {
  id           String      @id @default(cuid())
  code         String      @unique // EDU-LAP-021
  name         String
  category     String // Laptop, Access card, Lab kit, Phone…
  serialNo     String?
  purchaseDate DateTime?   @db.Date
  status       AssetStatus @default(AVAILABLE)
  employeeId   String?
  employee     Employee?   @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  assignedAt   DateTime?
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

// ─── Training ──────────────────────────────────────────────────────────────

model TrainingModule {
  id          String               @id @default(cuid())
  title       String               @unique
  description String?
  active      Boolean              @default(true)
  assignments TrainingAssignment[]
  createdAt   DateTime             @default(now())
}

enum TrainingStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
}

model TrainingAssignment {
  id          String         @id @default(cuid())
  employeeId  String
  employee    Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  moduleId    String
  module      TrainingModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  status      TrainingStatus @default(ASSIGNED)
  completedAt DateTime?
  createdAt   DateTime       @default(now())

  @@unique([employeeId, moduleId])
}

// ─── Payroll ───────────────────────────────────────────────────────────────

/// Monthly salary, effective from a date. The latest row on or before a month's start applies.
model SalaryStructure {
  id               String   @id @default(cuid())
  employeeId       String
  employee         Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  effectiveFrom    DateTime @db.Date
  basic            Decimal  @db.Decimal(12, 2)
  hra              Decimal  @default(0) @db.Decimal(12, 2)
  specialAllowance Decimal  @default(0) @db.Decimal(12, 2)
  note             String?
  createdAt        DateTime @default(now())

  @@unique([employeeId, effectiveFrom])
}

enum PayrollStatus {
  DRAFT
  FINALIZED
  PAID
}

model PayrollRun {
  id          String        @id @default(cuid())
  month       String        @unique // "2026-10"
  status      PayrollStatus @default(DRAFT)
  createdById String
  createdBy   User          @relation(fields: [createdById], references: [id])
  finalizedAt DateTime?
  paidOn      DateTime?     @db.Date
  payslips    Payslip[]
  createdAt   DateTime      @default(now())
}

model Payslip {
  id               String     @id @default(cuid())
  runId            String
  run              PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  employeeId       String
  employee         Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  daysInMonth      Int
  paidDays         Decimal    @db.Decimal(5, 1) // days employed in the month, minus LOP
  lopDays          Decimal    @default(0) @db.Decimal(5, 1)
  basic            Decimal    @db.Decimal(12, 2) // earned amounts, after proration
  hra              Decimal    @db.Decimal(12, 2)
  specialAllowance Decimal    @db.Decimal(12, 2)
  otherEarnings    Decimal    @default(0) @db.Decimal(12, 2) // bonus, reimbursement…
  gross            Decimal    @db.Decimal(12, 2)
  lopDeduction     Decimal    @default(0) @db.Decimal(12, 2)
  pf               Decimal    @default(0) @db.Decimal(12, 2)
  esi              Decimal    @default(0) @db.Decimal(12, 2)
  professionalTax  Decimal    @default(0) @db.Decimal(12, 2)
  tds              Decimal    @default(0) @db.Decimal(12, 2)
  otherDeductions  Decimal    @default(0) @db.Decimal(12, 2)
  totalDeductions  Decimal    @db.Decimal(12, 2)
  net              Decimal    @db.Decimal(12, 2)
  note             String?

  @@unique([runId, employeeId])
}

// ─── CRM ───────────────────────────────────────────────────────────────────

enum OrgType {
  SCHOOL
  COLLEGE
  UNIVERSITY
  CORPORATE
  GOVERNMENT
  NGO
  PARTNER
  OTHER
}

model Organization {
  id         String     @id @default(cuid())
  name       String
  type       OrgType    @default(SCHOOL)
  board      String? // CBSE, ICSE, State, IB… for schools
  phone      String?
  email      String?
  website    String?
  address    String?
  city       String?
  district   String?
  state      String?    @default("Kerala")
  notes      String?
  ownerId    String?
  owner      User?      @relation("OrgOwner", fields: [ownerId], references: [id])
  contacts   Contact[]
  deals      Deal[]
  activities Activity[]
  projects   Project[]
  programmes Programme[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([name])
}

model Contact {
  id             String        @id @default(cuid())
  name           String
  designation    String? // Principal, HOD, Director…
  email          String?
  phone          String?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  ownerId        String?
  owner          User?         @relation("ContactOwner", fields: [ownerId], references: [id])
  notes          String?
  deals          Deal[]
  activities     Activity[]
  programmes     Programme[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  CONVERTED
}

enum LeadSource {
  WEBSITE
  REFERRAL
  WALK_IN
  PHONE
  EMAIL
  SOCIAL
  EVENT
  OTHER
}

model Lead {
  id               String     @id @default(cuid())
  name             String // person's name
  organizationName String?
  orgType          OrgType?
  email            String?
  phone            String?
  city             String?
  interest         String? // what they asked about
  source           LeadSource @default(OTHER)
  status           LeadStatus @default(NEW)
  notes            String?
  ownerId          String?
  owner            User?      @relation("LeadOwner", fields: [ownerId], references: [id])
  convertedDealId  String?    @unique
  convertedDeal    Deal?      @relation(fields: [convertedDealId], references: [id], onDelete: SetNull)
  activities       Activity[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

enum DealStage {
  PROSPECT
  DEMO
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

model Deal {
  id             String        @id @default(cuid())
  title          String
  value          Decimal       @default(0) @db.Decimal(14, 2) // INR
  stage          DealStage     @default(PROSPECT)
  program        String? // STEM programme, engineering workshop, teacher training, kits…
  students       Int? // learners covered, for programmes and workshops
  expectedClose  DateTime?     @db.Date
  closedAt       DateTime?
  lostReason     String?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  contactId      String?
  contact        Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  ownerId        String?
  owner          User?         @relation("DealOwner", fields: [ownerId], references: [id])
  notes          String?
  lead           Lead?
  activities     Activity[]
  projects       Project[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([stage])
}

enum ActivityType {
  CALL
  MEETING
  EMAIL
  VISIT
  TASK
  NOTE
}

model Activity {
  id             String        @id @default(cuid())
  type           ActivityType  @default(NOTE)
  subject        String
  body           String?
  dueAt          DateTime?
  done           Boolean       @default(false)
  assigneeId     String?
  assignee       User?         @relation("ActivityAssignee", fields: [assigneeId], references: [id])
  createdById    String
  createdBy      User          @relation("ActivityCreator", fields: [createdById], references: [id])
  leadId         String?
  lead           Lead?         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  dealId         String?
  deal           Deal?         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contactId      String?
  contact        Contact?      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())

  @@index([assigneeId, done, dueAt])
}

// ─── Projects (from the Edubotics One Floot prototype) ─────────────────────

/// The eight-step delivery flow: Create → Assign → Plan → Execute → Review → Approval → Handover → Complete.
enum ProjectStage {
  CREATE
  ASSIGN
  PLAN
  EXECUTE
  REVIEW
  APPROVAL // waiting on an admin or the owner's manager
  HANDOVER
  COMPLETE
}

enum ProjectKind {
  SCHOOL_PROGRAMME
  COLLEGE_WORKSHOP
  STUDENT_PROJECT // college final-year projects
  TEACHER_TRAINING
  CLIENT_PROJECT
  INTERNAL
}

model Project {
  id             String        @id @default(cuid())
  name           String
  kind           ProjectKind   @default(CLIENT_PROJECT)
  description    String?
  stage          ProjectStage  @default(CREATE)
  onHold         Boolean       @default(false)
  startDate      DateTime?     @db.Date
  dueDate        DateTime?     @db.Date
  completedAt    DateTime?
  ownerId        String
  owner          User          @relation("ProjectOwner", fields: [ownerId], references: [id])
  departmentId   String?
  department     Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  dealId         String?
  deal           Deal?         @relation(fields: [dealId], references: [id], onDelete: SetNull)
  approvalNote   String? // the approver's note, or why it was sent back
  decidedById    String?
  decidedBy      User?         @relation("ProjectApprover", fields: [decidedById], references: [id])
  decidedAt      DateTime?
  members        ProjectMember[]
  milestones     Milestone[]
  tasks          ProjectTask[]
  timeEntries    TimeEntry[]
  programmes     Programme[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([stage])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String? // Trainer, Developer, Coordinator…
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
}

model Milestone {
  id        String        @id @default(cuid())
  projectId String
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  dueDate   DateTime?     @db.Date
  doneAt    DateTime?
  tasks     ProjectTask[]
  createdAt DateTime      @default(now())

  @@index([projectId])
}

enum WorkStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

model ProjectTask {
  id          String      @id @default(cuid())
  projectId   String
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestoneId String?
  milestone   Milestone?  @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  title       String
  description String?
  status      WorkStatus  @default(TODO)
  priority    Priority    @default(MEDIUM)
  dueDate     DateTime?   @db.Date
  completedAt DateTime?
  assigneeId  String?
  assignee    User?       @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById String
  createdBy   User        @relation("TaskCreator", fields: [createdById], references: [id])
  timeEntries TimeEntry[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([assigneeId, status])
  @@index([projectId])
}

// ─── Timesheets ────────────────────────────────────────────────────────────

enum TimesheetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED // sent back; the employee edits and submits again
}

/// One week (Monday start) of hours for one employee, approved by their manager or an admin.
model Timesheet {
  id           String          @id @default(cuid())
  employeeId   String
  employee     Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  weekStart    DateTime        @db.Date
  status       TimesheetStatus @default(DRAFT)
  submittedAt  DateTime?
  decidedById  String?
  decidedBy    User?           @relation("TimesheetApprover", fields: [decidedById], references: [id])
  decidedAt    DateTime?
  decisionNote String?
  entries      TimeEntry[]
  createdAt    DateTime        @default(now())

  @@unique([employeeId, weekStart])
}

model TimeEntry {
  id          String       @id @default(cuid())
  timesheetId String
  timesheet   Timesheet    @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  date        DateTime     @db.Date
  projectId   String?
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  taskId      String?
  task        ProjectTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  hours       Decimal      @db.Decimal(4, 2)
  note        String? // what was done; required when no project is picked
  createdAt   DateTime     @default(now())

  @@index([timesheetId, date])
}

// ─── Operations: school programme delivery ─────────────────────────────────

enum ProgrammeStatus {
  PLANNED
  RUNNING
  PAUSED
  COMPLETED
}

/// One school's programme for an academic year: the classes taught, who teaches them, and how many sessions.
model Programme {
  id              String             @id @default(cuid())
  name            String // "Robotics & Coding"
  organizationId  String
  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  contactId       String? // the school's coordinator
  contact         Contact?           @relation(fields: [contactId], references: [id], onDelete: SetNull)
  projectId       String? // the delivery project, when one was started from a won deal
  project         Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  academicYear    String? // "2026-27"
  grades          String? // "Grades 3 to 8"
  students        Int?
  sessionsPlanned Int? // contracted sessions for the year, for progress
  startDate       DateTime?          @db.Date
  endDate         DateTime?          @db.Date
  status          ProgrammeStatus    @default(PLANNED)
  coordinatorId   String // Edubotics person responsible for this school
  coordinator     User               @relation("ProgrammeCoordinator", fields: [coordinatorId], references: [id])
  notes           String?
  trainers        ProgrammeTrainer[]
  sessions        ProgrammeSession[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([organizationId])
}

/// A trainer assigned to a school, and which classes they take there.
model ProgrammeTrainer {
  id          String    @id @default(cuid())
  programmeId String
  programme   Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  classes     String? // "Grades 3 to 5"
  createdAt   DateTime  @default(now())

  @@unique([programmeId, userId])
}

enum SessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED // called off in advance (school event, exam, holiday)
  MISSED // should have happened and didn't
}

/// One class period at a school. The trainer logs it afterwards.
model ProgrammeSession {
  id              String        @id @default(cuid())
  programmeId     String
  programme       Programme     @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  date            DateTime      @db.Date
  startTime       String // "10:30", India time
  durationMins    Int           @default(60)
  classGroup      String? // "Grade 5 A"
  topic           String? // planned lesson
  trainerId       String?
  trainer         User?         @relation("SessionTrainer", fields: [trainerId], references: [id], onDelete: SetNull)
  status          SessionStatus @default(SCHEDULED)
  // Session log, filled in by the trainer afterwards.
  studentsPresent Int?
  covered         String? // what was actually taught
  notes           String?
  issues          String? // kit problems, behaviour, anything the coordinator should follow up
  loggedById      String?
  loggedBy        User?         @relation("SessionLogger", fields: [loggedById], references: [id], onDelete: SetNull)
  loggedAt        DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([programmeId, date])
  @@index([trainerId, date])
  @@index([date])
}
