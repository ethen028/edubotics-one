generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Access ────────────────────────────────────────────────────────────────

enum Role {
  ADMIN // full access, manages users and HR records
  MANAGER // approves leave for their team
  EMPLOYEE
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(EMPLOYEE)
  active       Boolean   @default(true)
  employee     Employee?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  ownedLeads            Lead[]               @relation("LeadOwner")
  ownedOrganizations    Organization[]       @relation("OrgOwner")
  ownedContacts         Contact[]            @relation("ContactOwner")
  ownedDeals            Deal[]               @relation("DealOwner")
  activities            Activity[]           @relation("ActivityAssignee")
  createdActivities     Activity[]           @relation("ActivityCreator")
  uploadedDocuments     EmployeeDocument[]   @relation("DocUploader")
  reviewedDocuments     EmployeeDocument[]   @relation("DocReviewer")
  payrollRuns           PayrollRun[]
  ownedProjects         Project[]            @relation("ProjectOwner")
  projectMembers        ProjectMember[]
  assignedTasks         ProjectTask[]        @relation("TaskAssignee")
  createdTasks          ProjectTask[]        @relation("TaskCreator")
  decidedProjects       Project[]            @relation("ProjectApprover")
  decidedTimesheets     Timesheet[]          @relation("TimesheetApprover")
  stockRequests         StockRequest[]       @relation("StockRequester")
  decidedStockReqs      StockRequest[]       @relation("StockApprover")
  stockMovements        StockMovement[]
  coordinatedProgrammes Programme[]          @relation("ProgrammeCoordinator")
  programmeTrainers     ProgrammeTrainer[]
  trainerSessions       ProgrammeSession[]   @relation("SessionTrainer")
  loggedSessions        ProgrammeSession[]   @relation("SessionLogger")
  projectUpdates        ProjectUpdate[]
  projectFiles          ProjectFile[]
  decidedClaims         ExpenseClaim[]       @relation("ClaimApprover")
  createdInvoices       Invoice[]            @relation("InvoiceCreator")
  createdQuotes         Quote[]              @relation("QuoteCreator")
  recordedPayments      InvoicePayment[]
  createdCreditNotes    CreditNote[]         @relation("CreditNoteCreator")
  purchaseOrders        PurchaseOrder[]      @relation("PORequester")
  decidedPurchases      PurchaseOrder[]      @relation("POApprover")
  purchaseReceipts      PurchaseReceipt[]
  vendorBills           VendorBill[]
  vendorPayments        VendorPayment[]
  hiringJobs            JobOpening[]         @relation("JobHiringManager")
  createdJobs           JobOpening[]         @relation("JobCreator")
  addedCandidates       Candidate[]          @relation("CandidateCreator")
  candidateFiles        CandidateFile[]
  interviewsTaken       Interview[]          @relation("Interviewer")
  interviewsBooked      Interview[]          @relation("InterviewScheduler")
  createdOffers         Offer[]
  notices               Notice[]
  noticeAcks            NoticeAck[]
  helpdeskRequests      HelpdeskTicket[]     @relation("TicketRequester")
  helpdeskAssigned      HelpdeskTicket[]     @relation("TicketAssignee")
  helpdeskComments      HelpdeskComment[]
  helpdeskFiles         HelpdeskAttachment[]
  sentEmails            EmailLog[]
  checklistTemplates    ChecklistTemplate[]
  checklistAssignments  ChecklistAssignee[]
  checklistRuns         ChecklistRun[]       @relation("ChecklistRunner")
  checklistTicks        ChecklistTick[]
}

// ─── HRM ───────────────────────────────────────────────────────────────────

model Department {
  id        String       @id @default(cuid())
  name      String       @unique
  employees Employee[]
  projects  Project[]
  createdAt DateTime     @default(now())
  jobs      JobOpening[]
  offers    Offer[]
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum EmployeeStatus {
  ONBOARDING
  ACTIVE
  ON_NOTICE
  EXITED
}

model Employee {
  id               String                 @id @default(cuid())
  code             String                 @unique // e.g. EBG-001
  firstName        String
  lastName         String
  workEmail        String                 @unique
  personalEmail    String?
  phone            String?
  designation      String
  departmentId     String?
  department       Department?            @relation(fields: [departmentId], references: [id])
  managerId        String?
  manager          Employee?              @relation("Reports", fields: [managerId], references: [id])
  reports          Employee[]             @relation("Reports")
  employmentType   EmploymentType         @default(FULL_TIME)
  status           EmployeeStatus         @default(ACTIVE)
  dateOfJoining    DateTime               @db.Date
  dateOfExit       DateTime?              @db.Date
  dateOfBirth      DateTime?              @db.Date
  gender           String?
  bloodGroup       String?
  address          String?
  city             String?
  state            String?                @default("Kerala")
  emergencyName    String?
  emergencyPhone   String?
  userId           String?                @unique
  user             User?                  @relation(fields: [userId], references: [id])
  leaveRequests    LeaveRequest[]         @relation("LeaveApplicant")
  approvedRequests LeaveRequest[]         @relation("LeaveApprover")
  attendance       AttendanceSession[]
  attendanceMarks  AttendanceMark[]
  corrections      AttendanceCorrection[]
  onboardingTasks  OnboardingTask[]
  documents        EmployeeDocument[]
  assets           Asset[]
  trainings        TrainingAssignment[]
  salaries         SalaryStructure[]
  payslips         Payslip[]
  timesheets       Timesheet[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  expenseClaims    ExpenseClaim[]
  hiredFrom        Candidate?             @relation("HiredAs")
  offersToReport   Offer[]                @relation("OfferManager")
}

model LeaveType {
  id          String         @id @default(cuid())
  code        String         @unique // CL, SL, EL, LOP
  name        String
  annualQuota Float          @default(0) // days per calendar year; 0 = unlimited (e.g. LOP)
  paid        Boolean        @default(true)
  active      Boolean        @default(true)
  requests    LeaveRequest[]
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveRequest {
  id           String      @id @default(cuid())
  employeeId   String
  employee     Employee    @relation("LeaveApplicant", fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId  String
  leaveType    LeaveType   @relation(fields: [leaveTypeId], references: [id])
  startDate    DateTime    @db.Date
  endDate      DateTime    @db.Date
  halfDay      Boolean     @default(false)
  days         Float // working days, excluding Sundays and holidays
  reason       String
  status       LeaveStatus @default(PENDING)
  approverId   String?
  approver     Employee?   @relation("LeaveApprover", fields: [approverId], references: [id])
  decisionNote String?
  decidedAt    DateTime?
  createdAt    DateTime    @default(now())

  @@index([employeeId, startDate])
}

model Holiday {
  id        String   @id @default(cuid())
  date      DateTime @unique @db.Date
  name      String
  optional  Boolean  @default(false) // restricted holiday
  tentative Boolean  @default(false) // date depends on the moon or isn't notified yet
}

// ─── Company settings (single row, id = 1) ─────────────────────────────────

model CompanySettings {
  id                Int   @id @default(1)
  workMinutesPerDay Int   @default(540) // 9 hours, as in Edubotics HR V1.2
  overtimeAfterMins Int   @default(30) // OD once a day runs this far past the target
  weeklyOffDays     Int[] @default([0, 6]) // 0 = Sunday … 6 = Saturday

  // Payroll. Deductions start switched off (Edubotics deducts none today).
  lopDivisor Int     @default(30) // LOP per day = monthly gross ÷ this, as in HR V1.2
  pfEnabled  Boolean @default(false)
  esiEnabled Boolean @default(false)
  ptEnabled  Boolean @default(false)
  tdsEnabled Boolean @default(false)

  // Expense claims: own-vehicle travel paid per km. 0 = enter the amount by hand.
  twoWheelerRatePerKm Decimal @default(0) @db.Decimal(6, 2)
  carRatePerKm        Decimal @default(0) @db.Decimal(6, 2)

  // Invoicing. Printed at the top of every invoice; edit under Admin → Settings.
  companyName      String  @default("Edubotics Global")
  companyAddress   String  @default("Edappally, Kochi, Kerala")
  companyState     String  @default("Kerala") // decides CGST + SGST (same state) or IGST
  companyPhone     String?
  companyEmail     String?
  gstin            String?
  pan              String?
  gstEnabled       Boolean @default(true) // off = plain invoices with no tax
  defaultGstRate   Int     @default(18)
  defaultSac       String? @default("999293") // commercial training and coaching services
  invoicePrefix    String  @default("EBG") // EBG/26-27/001; quotes are EBG/Q/26-27/001
  paymentTermsDays Int     @default(15)
  bankName         String?
  bankAccountName  String?
  bankAccountNo    String?
  bankIfsc         String?
  upiId            String?
  invoiceNote      String? // printed at the bottom, e.g. "Please quote the invoice number when paying."
  quoteValidDays   Int     @default(30) // a new quote is valid this many days
  quoteTerms       String? // starting terms on every new quote, e.g. "50% advance, balance on completion"

  // Email: the company's own mail account (e.g. Google Workspace or Gmail with an app password).
  // Nothing is sent until a test email from Admin → Settings goes through (mailVerifiedAt).
  smtpHost        String?
  smtpPort        Int       @default(587)
  smtpSecure      Boolean   @default(false) // true for port 465; 587 upgrades with STARTTLS
  smtpUser        String?
  smtpPassword    String? // encrypted with the session secret, see src/lib/secret-box.ts
  mailFromName    String?
  mailFromAddress String?
  mailReplyTo     String?
  mailBccSelf     Boolean   @default(true) // a copy of every email to the from address, for the sent record
  mailVerifiedAt  DateTime? // cleared whenever the account details change
}

// ─── Attendance ────────────────────────────────────────────────────────────

/// One check-in/check-out pair. A day can have several sessions.
model AttendanceSession {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workDate   DateTime  @db.Date // IST calendar date of the check-in
  checkIn    DateTime
  checkOut   DateTime?
  createdAt  DateTime  @default(now())

  corrections AttendanceCorrection[]

  @@index([employeeId, workDate])
}

enum AttendanceStatus {
  PRESENT
  INCOMPLETE // ID: worked less than the daily target
  OVERTIME // OD: worked past the target plus the overtime threshold
  ABSENT
  LEAVE
  MISPUNCH // checked in but never checked out
  HOLIDAY
  WEEKLY_OFF
}

/// HR/admin decision for a day that replaces the computed status.
model AttendanceMark {
  id         String           @id @default(cuid())
  employeeId String
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workDate   DateTime         @db.Date
  status     AttendanceStatus
  note       String?
  markedById String
  createdAt  DateTime         @default(now())

  @@unique([employeeId, workDate])
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Punch-out regularization: the employee forgot to check out.
model AttendanceCorrection {
  id                String            @id @default(cuid())
  employeeId        String
  employee          Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  sessionId         String
  session           AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  requestedCheckOut DateTime
  reason            String
  status            RequestStatus     @default(PENDING)
  decidedById       String?
  decidedAt         DateTime?
  createdAt         DateTime          @default(now())
}

// ─── Onboarding ────────────────────────────────────────────────────────────

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  NOT_APPLICABLE
}

model OnboardingTask {
  id         String     @id @default(cuid())
  employeeId String
  employee   Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title      String
  category   String // Documents, Admin, IT Setup, HR, Manager, Training
  dueDate    DateTime?  @db.Date
  status     TaskStatus @default(PENDING)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([employeeId])
}

// ─── Documents ─────────────────────────────────────────────────────────────

enum DocumentStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

/// Files live in Postgres so the app needs no separate storage service (5 MB cap each).
model EmployeeDocument {
  id           String         @id @default(cuid())
  employeeId   String
  employee     Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type         String // Aadhaar / ID proof, PAN card, Bank details, Offer letter…
  fileName     String
  mimeType     String
  size         Int
  data         Bytes
  status       DocumentStatus @default(PENDING)
  reviewNote   String?
  uploadedById String
  uploadedBy   User           @relation("DocUploader", fields: [uploadedById], references: [id])
  reviewedById String?
  reviewedBy   User?          @relation("DocReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  createdAt    DateTime       @default(now())

  @@index([employeeId])
}

// ─── Assets ────────────────────────────────────────────────────────────────

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  REPAIR
  RETIRED
}

model Asset {
  id           String           @id @default(cuid())
  code         String           @unique // EDU-LAP-021
  name         String
  category     String // Laptop, Access card, Lab kit, Phone…
  serialNo     String?
  purchaseDate DateTime?        @db.Date
  status       AssetStatus      @default(AVAILABLE)
  employeeId   String?
  employee     Employee?        @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  assignedAt   DateTime?
  notes        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  tickets      HelpdeskTicket[]
}

// ─── Training ──────────────────────────────────────────────────────────────

model TrainingModule {
  id          String               @id @default(cuid())
  title       String               @unique
  description String?
  active      Boolean              @default(true)
  assignments TrainingAssignment[]
  createdAt   DateTime             @default(now())
}

enum TrainingStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
}

model TrainingAssignment {
  id          String         @id @default(cuid())
  employeeId  String
  employee    Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  moduleId    String
  module      TrainingModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  status      TrainingStatus @default(ASSIGNED)
  completedAt DateTime?
  createdAt   DateTime       @default(now())

  @@unique([employeeId, moduleId])
}

// ─── Payroll ───────────────────────────────────────────────────────────────

/// Monthly salary, effective from a date. The latest row on or before a month's start applies.
model SalaryStructure {
  id               String   @id @default(cuid())
  employeeId       String
  employee         Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  effectiveFrom    DateTime @db.Date
  basic            Decimal  @db.Decimal(12, 2)
  hra              Decimal  @default(0) @db.Decimal(12, 2)
  specialAllowance Decimal  @default(0) @db.Decimal(12, 2)
  note             String?
  createdAt        DateTime @default(now())

  @@unique([employeeId, effectiveFrom])
}

enum PayrollStatus {
  DRAFT
  FINALIZED
  PAID
}

model PayrollRun {
  id          String        @id @default(cuid())
  month       String        @unique // "2026-10"
  status      PayrollStatus @default(DRAFT)
  createdById String
  createdBy   User          @relation(fields: [createdById], references: [id])
  finalizedAt DateTime?
  paidOn      DateTime?     @db.Date
  payslips    Payslip[]
  createdAt   DateTime      @default(now())
}

model Payslip {
  id               String         @id @default(cuid())
  runId            String
  run              PayrollRun     @relation(fields: [runId], references: [id], onDelete: Cascade)
  employeeId       String
  employee         Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  daysInMonth      Int
  paidDays         Decimal        @db.Decimal(5, 1) // days employed in the month, minus LOP
  lopDays          Decimal        @default(0) @db.Decimal(5, 1)
  basic            Decimal        @db.Decimal(12, 2) // earned amounts, after proration
  hra              Decimal        @db.Decimal(12, 2)
  specialAllowance Decimal        @db.Decimal(12, 2)
  otherEarnings    Decimal        @default(0) @db.Decimal(12, 2) // bonus, reimbursement…
  gross            Decimal        @db.Decimal(12, 2)
  lopDeduction     Decimal        @default(0) @db.Decimal(12, 2)
  pf               Decimal        @default(0) @db.Decimal(12, 2)
  esi              Decimal        @default(0) @db.Decimal(12, 2)
  professionalTax  Decimal        @default(0) @db.Decimal(12, 2)
  tds              Decimal        @default(0) @db.Decimal(12, 2)
  otherDeductions  Decimal        @default(0) @db.Decimal(12, 2)
  totalDeductions  Decimal        @db.Decimal(12, 2)
  net              Decimal        @db.Decimal(12, 2)
  note             String?
  reimbursements   Decimal        @default(0) @db.Decimal(12, 2) // approved expense claims, paid on top of salary
  expenseClaims    ExpenseClaim[]
  emails           EmailLog[]

  @@unique([runId, employeeId])
}

// ─── CRM ───────────────────────────────────────────────────────────────────

enum OrgType {
  SCHOOL
  COLLEGE
  UNIVERSITY
  CORPORATE
  GOVERNMENT
  NGO
  PARTNER
  OTHER
}

model Organization {
  id            String         @id @default(cuid())
  name          String
  type          OrgType        @default(SCHOOL)
  board         String? // CBSE, ICSE, State, IB… for schools
  phone         String?
  email         String?
  website       String?
  address       String?
  city          String?
  district      String?
  state         String?        @default("Kerala")
  notes         String?
  ownerId       String?
  owner         User?          @relation("OrgOwner", fields: [ownerId], references: [id])
  contacts      Contact[]
  deals         Deal[]
  activities    Activity[]
  projects      Project[]
  programmes    Programme[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  expenseClaims ExpenseClaim[]
  gstin         String? // printed on invoices; schools usually have none
  invoices      Invoice[]
  quotes        Quote[]

  @@index([name])
}

model Contact {
  id             String        @id @default(cuid())
  name           String
  designation    String? // Principal, HOD, Director…
  email          String?
  phone          String?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  ownerId        String?
  owner          User?         @relation("ContactOwner", fields: [ownerId], references: [id])
  notes          String?
  deals          Deal[]
  activities     Activity[]
  programmes     Programme[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  invoices       Invoice[]
  quotes         Quote[]
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  CONVERTED
}

enum LeadSource {
  WEBSITE
  REFERRAL
  WALK_IN
  PHONE
  EMAIL
  SOCIAL
  EVENT
  OTHER
}

model Lead {
  id               String     @id @default(cuid())
  name             String // person's name
  organizationName String?
  orgType          OrgType?
  email            String?
  phone            String?
  city             String?
  interest         String? // what they asked about
  source           LeadSource @default(OTHER)
  status           LeadStatus @default(NEW)
  notes            String?
  ownerId          String?
  owner            User?      @relation("LeadOwner", fields: [ownerId], references: [id])
  convertedDealId  String?    @unique
  convertedDeal    Deal?      @relation(fields: [convertedDealId], references: [id], onDelete: SetNull)
  activities       Activity[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

enum DealStage {
  PROSPECT
  DEMO
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

model Deal {
  id             String        @id @default(cuid())
  title          String
  value          Decimal       @default(0) @db.Decimal(14, 2) // INR
  stage          DealStage     @default(PROSPECT)
  program        String? // STEM programme, engineering workshop, teacher training, kits…
  students       Int? // learners covered, for programmes and workshops
  expectedClose  DateTime?     @db.Date
  closedAt       DateTime?
  lostReason     String?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  contactId      String?
  contact        Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  ownerId        String?
  owner          User?         @relation("DealOwner", fields: [ownerId], references: [id])
  notes          String?
  lead           Lead?
  activities     Activity[]
  projects       Project[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  invoices       Invoice[]
  quotes         Quote[]

  @@index([stage])
}

enum ActivityType {
  CALL
  MEETING
  EMAIL
  VISIT
  TASK
  NOTE
}

model Activity {
  id             String        @id @default(cuid())
  type           ActivityType  @default(NOTE)
  subject        String
  body           String?
  dueAt          DateTime?
  done           Boolean       @default(false)
  assigneeId     String?
  assignee       User?         @relation("ActivityAssignee", fields: [assigneeId], references: [id])
  createdById    String
  createdBy      User          @relation("ActivityCreator", fields: [createdById], references: [id])
  leadId         String?
  lead           Lead?         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  dealId         String?
  deal           Deal?         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contactId      String?
  contact        Contact?      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())

  @@index([assigneeId, done, dueAt])
}

// ─── Projects (from the Edubotics One Floot prototype) ─────────────────────

/// The eight-step delivery flow: Create → Assign → Plan → Execute → Review → Approval → Handover → Complete.
enum ProjectStage {
  CREATE
  ASSIGN
  PLAN
  EXECUTE
  REVIEW
  APPROVAL // waiting on an admin or the owner's manager
  HANDOVER
  COMPLETE
}

enum ProjectKind {
  SCHOOL_PROGRAMME
  COLLEGE_WORKSHOP
  STUDENT_PROJECT // college final-year projects
  TEACHER_TRAINING
  CLIENT_PROJECT
  INTERNAL
}

model Project {
  id             String          @id @default(cuid())
  name           String
  kind           ProjectKind     @default(CLIENT_PROJECT)
  description    String?
  stage          ProjectStage    @default(CREATE)
  onHold         Boolean         @default(false)
  startDate      DateTime?       @db.Date
  dueDate        DateTime?       @db.Date
  completedAt    DateTime?
  ownerId        String
  owner          User            @relation("ProjectOwner", fields: [ownerId], references: [id])
  departmentId   String?
  department     Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  organizationId String?
  organization   Organization?   @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  dealId         String?
  deal           Deal?           @relation(fields: [dealId], references: [id], onDelete: SetNull)
  approvalNote   String? // the approver's note, or why it was sent back
  decidedById    String?
  decidedBy      User?           @relation("ProjectApprover", fields: [decidedById], references: [id])
  decidedAt      DateTime?
  members        ProjectMember[]
  milestones     Milestone[]
  tasks          ProjectTask[]
  timeEntries    TimeEntry[]
  stockRequests  StockRequest[]
  stockMovements StockMovement[]
  programmes     Programme[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  updates        ProjectUpdate[]
  files          ProjectFile[]
  expenseClaims  ExpenseClaim[]
  invoices       Invoice[]
  purchaseOrders PurchaseOrder[]

  @@index([stage])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String? // Trainer, Developer, Coordinator…
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
}

model Milestone {
  id        String        @id @default(cuid())
  projectId String
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  dueDate   DateTime?     @db.Date
  doneAt    DateTime?
  tasks     ProjectTask[]
  createdAt DateTime      @default(now())

  @@index([projectId])
}

enum WorkStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

model ProjectTask {
  id                String          @id @default(cuid())
  projectId         String
  project           Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestoneId       String?
  milestone         Milestone?      @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  title             String
  description       String?
  status            WorkStatus      @default(TODO)
  priority          Priority        @default(MEDIUM)
  progress          Int             @default(0) // 0–100, set by the assignee when they post an update (Task Flow)
  dueDate           DateTime?       @db.Date
  completedAt       DateTime?
  /// Set when the owner asks the assignee for an update; cleared when the assignee posts one.
  updateRequestedAt DateTime?
  assigneeId        String?
  assignee          User?           @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById       String
  createdBy         User            @relation("TaskCreator", fields: [createdById], references: [id])
  timeEntries       TimeEntry[]
  updates           ProjectUpdate[]
  files             ProjectFile[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([assigneeId, status])
  @@index([projectId])
}

/// A progress report on a project or one of its tasks: a note, a progress change and/or files (from Task Flow).
model ProjectUpdate {
  id           String        @id @default(cuid())
  projectId    String
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId       String?
  task         ProjectTask?  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId     String
  author       User          @relation(fields: [authorId], references: [id])
  note         String?
  progressFrom Int?
  progressTo   Int?
  statusTo     WorkStatus?
  /// The owner asking for an update, rather than reporting one.
  isRequest    Boolean       @default(false)
  files        ProjectFile[]
  createdAt    DateTime      @default(now())

  @@index([projectId, createdAt])
  @@index([taskId])
}

/// A file attached to a project, kept in the database like employee documents.
model ProjectFile {
  id           String         @id @default(cuid())
  projectId    String
  project      Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId       String?
  task         ProjectTask?   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  updateId     String?
  update       ProjectUpdate? @relation(fields: [updateId], references: [id], onDelete: Cascade)
  fileName     String
  mimeType     String
  size         Int
  data         Bytes
  uploadedById String
  uploadedBy   User           @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime       @default(now())

  @@index([projectId])
  @@index([taskId])
}

// ─── Timesheets ────────────────────────────────────────────────────────────

enum TimesheetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED // sent back; the employee edits and submits again
}

/// One week (Monday start) of hours for one employee, approved by their manager or an admin.
model Timesheet {
  id           String          @id @default(cuid())
  employeeId   String
  employee     Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  weekStart    DateTime        @db.Date
  status       TimesheetStatus @default(DRAFT)
  submittedAt  DateTime?
  decidedById  String?
  decidedBy    User?           @relation("TimesheetApprover", fields: [decidedById], references: [id])
  decidedAt    DateTime?
  decisionNote String?
  entries      TimeEntry[]
  createdAt    DateTime        @default(now())

  @@unique([employeeId, weekStart])
}

enum DailyWorkStatus {
  COMPLETED
  IN_PROGRESS
  PENDING
  BLOCKED
}

model TimeEntry {
  id          String           @id @default(cuid())
  timesheetId String
  timesheet   Timesheet        @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  date        DateTime         @db.Date
  projectId   String?
  project     Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  taskId      String?
  task        ProjectTask?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  hours       Decimal          @db.Decimal(4, 2)
  note        String? // what was done; required when no project is picked
  // Daily work log (Task Flow's worksheet): optional clock times, a headline, how it went and remarks.
  startTime   String? // "09:30"
  endTime     String? // "18:30"
  title       String?
  workStatus  DailyWorkStatus?
  remarks     String?
  createdAt   DateTime         @default(now())
  // WorkPulse: entries can be corrected while the week is open; the team view shows they were changed.
  editCount   Int              @default(0)
  editedAt    DateTime?

  @@index([timesheetId, date])
}

// ─── Inventory ─────────────────────────────────────────────────────────────
// Kits, parts and consumables counted by quantity. Equipment tracked one by one
// and issued to a person (laptops, access cards) stays in HR → Assets.

/// One stocked thing: a robotics kit, a sensor, a pack of jumper wires.
model StockItem {
  id           String              @id @default(cuid())
  sku          String              @unique // EB-KIT-ARD-01
  name         String
  category     String // see INVENTORY_CATEGORIES
  unit         String              @default("pcs") // pcs, kit, set, pack, m
  location     String? // shelf, cupboard, branch
  returnable   Boolean             @default(true) // kits come back after a programme; consumables don't
  onHand       Int                 @default(0) // kept in step with StockMovement
  reorderLevel Int                 @default(0) // low-stock alert at or below this
  unitCost     Decimal?            @db.Decimal(10, 2)
  notes        String?
  active       Boolean             @default(true)
  movements    StockMovement[]
  requestLines StockRequestLine[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  poLines      PurchaseOrderLine[]

  @@index([category])
}

enum StockMovementType {
  RECEIVE // bought or built, adds stock
  ISSUE // handed out against a request
  RETURN // came back from a request
  ADJUST // stock count correction (either way)
  WRITE_OFF // lost, damaged or used up
}

/// Every change to onHand, so the count can be traced.
model StockMovement {
  id        String            @id @default(cuid())
  itemId    String
  item      StockItem         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type      StockMovementType
  quantity  Int // signed: + into stock, - out of stock
  note      String?
  requestId String?
  request   StockRequest?     @relation(fields: [requestId], references: [id], onDelete: SetNull)
  projectId String?
  project   Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  byId      String
  by        User              @relation(fields: [byId], references: [id])
  createdAt DateTime          @default(now())
  receiptId String? // received against a purchase order
  receipt   PurchaseReceipt?  @relation(fields: [receiptId], references: [id], onDelete: SetNull)

  @@index([itemId, createdAt])
}

enum StockRequestStatus {
  PENDING // waiting for approval
  APPROVED // approved, not yet handed out
  REJECTED
  CANCELLED
  ISSUED // handed out; returnable items still out
  CLOSED // everything returned, used up or written off
}

/// Someone asks for kits or parts, usually for a project. Approved in the Approvals inbox, then issued from stock.
model StockRequest {
  id           String             @id @default(cuid())
  number       Int                @unique @default(autoincrement()) // shown as REQ-0001
  requesterId  String
  requester    User               @relation("StockRequester", fields: [requesterId], references: [id])
  projectId    String?
  project      Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  purpose      String
  neededBy     DateTime?          @db.Date
  returnBy     DateTime?          @db.Date
  status       StockRequestStatus @default(PENDING)
  decidedById  String?
  decidedBy    User?              @relation("StockApprover", fields: [decidedById], references: [id])
  decidedAt    DateTime?
  decisionNote String?
  issuedAt     DateTime?
  closedAt     DateTime?
  lines        StockRequestLine[]
  movements    StockMovement[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([status])
  @@index([requesterId])
}

model StockRequestLine {
  id         String       @id @default(cuid())
  requestId  String
  request    StockRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  itemId     String
  item       StockItem    @relation(fields: [itemId], references: [id])
  quantity   Int // asked for
  issued     Int          @default(0)
  returned   Int          @default(0)
  writtenOff Int          @default(0) // lost, damaged or used up

  @@unique([requestId, itemId])
}

// ─── Operations: school programme delivery ─────────────────────────────────

enum ProgrammeStatus {
  PLANNED
  RUNNING
  PAUSED
  COMPLETED
}

/// One school's programme for an academic year: the classes taught, who teaches them, and how many sessions.
model Programme {
  id              String             @id @default(cuid())
  name            String // "Robotics & Coding"
  organizationId  String
  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  contactId       String? // the school's coordinator
  contact         Contact?           @relation(fields: [contactId], references: [id], onDelete: SetNull)
  projectId       String? // the delivery project, when one was started from a won deal
  project         Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  academicYear    String? // "2026-27"
  grades          String? // "Grades 3 to 8"
  students        Int?
  sessionsPlanned Int? // contracted sessions for the year, for progress
  startDate       DateTime?          @db.Date
  endDate         DateTime?          @db.Date
  status          ProgrammeStatus    @default(PLANNED)
  coordinatorId   String // Edubotics person responsible for this school
  coordinator     User               @relation("ProgrammeCoordinator", fields: [coordinatorId], references: [id])
  notes           String?
  trainers        ProgrammeTrainer[]
  sessions        ProgrammeSession[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([organizationId])
}

/// A trainer assigned to a school, and which classes they take there.
model ProgrammeTrainer {
  id          String    @id @default(cuid())
  programmeId String
  programme   Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  classes     String? // "Grades 3 to 5"
  createdAt   DateTime  @default(now())

  @@unique([programmeId, userId])
}

enum SessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED // called off in advance (school event, exam, holiday)
  MISSED // should have happened and didn't
}

/// One class period at a school. The trainer logs it afterwards.
model ProgrammeSession {
  id              String         @id @default(cuid())
  programmeId     String
  programme       Programme      @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  date            DateTime       @db.Date
  startTime       String // "10:30", India time
  durationMins    Int            @default(60)
  classGroup      String? // "Grade 5 A"
  topic           String? // planned lesson
  trainerId       String?
  trainer         User?          @relation("SessionTrainer", fields: [trainerId], references: [id], onDelete: SetNull)
  status          SessionStatus  @default(SCHEDULED)
  // Session log, filled in by the trainer afterwards.
  studentsPresent Int?
  covered         String? // what was actually taught
  notes           String?
  issues          String? // kit problems, behaviour, anything the coordinator should follow up
  loggedById      String?
  loggedBy        User?          @relation("SessionLogger", fields: [loggedById], references: [id], onDelete: SetNull)
  loggedAt        DateTime?
  checklistRuns   ChecklistRun[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([programmeId, date])
  @@index([trainerId, date])
  @@index([date])
}

// ─── Expense claims ────────────────────────────────────────────────────────

enum ExpenseCategory {
  TRAVEL
  FOOD
  LODGING
  KITS_MATERIALS // parts or materials bought for a session or project
  PRINTING
  PHONE_INTERNET
  OTHER
}

enum ClaimStatus {
  SUBMITTED // waiting for the manager or an admin
  APPROVED // to be paid: in the next payroll, or by hand
  REJECTED
  PAID
}

/// Money an employee spent for work and wants back. Approved claims ride on the next payroll run.
model ExpenseClaim {
  id             String          @id @default(cuid())
  employeeId     String
  employee       Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date           DateTime        @db.Date // when the money was spent
  category       ExpenseCategory
  description    String // what it was for, e.g. "Kakkanad ↔ Choice School, robotics class"
  amount         Decimal         @db.Decimal(12, 2) // claimed
  approvedAmount Decimal?        @db.Decimal(12, 2) // what will be paid; may be less than claimed
  distanceKm     Decimal?        @db.Decimal(7, 1) // own-vehicle travel
  vehicle        String? // TWO_WHEELER or CAR, for own-vehicle travel
  projectId      String?
  project        Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  organizationId String?
  organization   Organization?   @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  receipt        ExpenseReceipt?
  status         ClaimStatus     @default(SUBMITTED)
  decidedById    String?
  decidedBy      User?           @relation("ClaimApprover", fields: [decidedById], references: [id])
  decidedAt      DateTime?
  decisionNote   String?
  payslipId      String? // set while the claim is on a payroll run
  payslip        Payslip?        @relation(fields: [payslipId], references: [id], onDelete: SetNull)
  paidOn         DateTime?       @db.Date
  paidNote       String? // how it was paid when not through payroll, e.g. "UPI"
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([employeeId, date])
  @@index([status])
}

/// The bill or photo of it, kept apart so lists don't load file bytes (5 MB cap).
model ExpenseReceipt {
  id       String       @id @default(cuid())
  claimId  String       @unique
  claim    ExpenseClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  fileName String
  mimeType String
  size     Int
  data     Bytes
}

// ─── Invoicing ─────────────────────────────────────────────────────────────

enum InvoiceStatus {
  DRAFT // editable, no number yet
  ISSUED // numbered and sent to the school; paid or not is worked out from payments
  CANCELLED // keeps its number, as GST requires; amounts no longer count
}

enum PaymentMethod {
  BANK_TRANSFER
  UPI
  CHEQUE
  CASH
  OTHER
}

/// A bill to a school or other institution. Amounts are stored when saved so printed invoices never change.
model Invoice {
  id             String           @id @default(cuid())
  fy             String? // financial year of the issue date, "26-27"
  seq            Int? // running number within the financial year
  number         String?          @unique // EBG/26-27/001, given when issued
  status         InvoiceStatus    @default(DRAFT)
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  contactId      String?
  contact        Contact?         @relation(fields: [contactId], references: [id], onDelete: SetNull)
  dealId         String?
  deal           Deal?            @relation(fields: [dealId], references: [id], onDelete: SetNull)
  projectId      String?
  project        Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  billToName     String
  billToAddress  String?
  billToGstin    String?
  placeOfSupply  String // state; same as the company's → CGST + SGST, else IGST
  issueDate      DateTime         @db.Date
  dueDate        DateTime         @db.Date
  subtotal       Decimal          @db.Decimal(14, 2)
  cgst           Decimal          @default(0) @db.Decimal(14, 2)
  sgst           Decimal          @default(0) @db.Decimal(14, 2)
  igst           Decimal          @default(0) @db.Decimal(14, 2)
  total          Decimal          @db.Decimal(14, 2)
  notes          String?
  issuedAt       DateTime?
  cancelledAt    DateTime?
  cancelReason   String?
  createdById    String
  quoteId        String? // the accepted quote this invoice bills
  quote          Quote?           @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  createdBy      User             @relation("InvoiceCreator", fields: [createdById], references: [id])
  lines          InvoiceLine[]
  payments       InvoicePayment[]
  creditNotes    CreditNote[]
  emails         EmailLog[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([fy, seq])
  @@index([organizationId])
  @@index([status, dueDate])
}

model InvoiceLine {
  id          String           @id @default(cuid())
  invoiceId   String
  invoice     Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position    Int
  description String
  sac         String? // SAC/HSN code
  quantity    Decimal          @db.Decimal(10, 2)
  unitPrice   Decimal          @db.Decimal(12, 2)
  gstRate     Decimal          @default(0) @db.Decimal(5, 2) // percent
  amount      Decimal          @db.Decimal(14, 2) // quantity × unit price, before tax
  credited    CreditNoteLine[]

  @@index([invoiceId])
}

/// Money received against an invoice. TDS the school withheld also settles the invoice.
model InvoicePayment {
  id           String        @id @default(cuid())
  invoiceId    String
  invoice      Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  receivedOn   DateTime      @db.Date
  amount       Decimal       @db.Decimal(14, 2) // received in the bank or in hand
  tds          Decimal       @default(0) @db.Decimal(14, 2) // withheld by the school as income tax
  method       PaymentMethod @default(BANK_TRANSFER)
  reference    String? // UTR, cheque number…
  note         String?
  recordedById String
  recordedBy   User          @relation(fields: [recordedById], references: [id])
  createdAt    DateTime      @default(now())

  @@index([invoiceId])
}

// ─── Credit notes ──────────────────────────────────────────────────────────
// Corrects or partly cancels an issued invoice the GST way: its own number series, the same
// tax split as the invoice, and it lowers what the school owes on that invoice.

enum CreditNoteStatus {
  ISSUED // numbered; counts against the invoice
  CANCELLED // keeps its number; no longer counts
}

enum CreditNoteReason {
  SESSIONS_NOT_HELD // fewer sessions or days delivered than billed
  WRONG_AMOUNT // price, quantity or rate was wrong on the invoice
  DISCOUNT // discount agreed after the invoice
  SERVICE_ISSUE // deficiency in service
  CANCEL_INVOICE // the whole invoice is withdrawn
  OTHER
}

model CreditNote {
  id              String           @id @default(cuid())
  fy              String // financial year of the credit note date, "26-27"
  seq             Int
  number          String           @unique // EBG/CN/26-27/001
  status          CreditNoteStatus @default(ISSUED)
  invoiceId       String
  invoice         Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  reason          CreditNoteReason
  reasonNote      String? // printed on the credit note
  issueDate       DateTime         @db.Date
  subtotal        Decimal          @db.Decimal(14, 2)
  cgst            Decimal          @default(0) @db.Decimal(14, 2)
  sgst            Decimal          @default(0) @db.Decimal(14, 2)
  igst            Decimal          @default(0) @db.Decimal(14, 2)
  total           Decimal          @db.Decimal(14, 2)
  // Money paid back to the school when the credit is more than what was still due.
  refundAmount    Decimal          @default(0) @db.Decimal(14, 2)
  refundedOn      DateTime?        @db.Date
  refundMethod    PaymentMethod?
  refundReference String?
  cancelledAt     DateTime?
  cancelReason    String?
  createdById     String
  createdBy       User             @relation("CreditNoteCreator", fields: [createdById], references: [id])
  lines           CreditNoteLine[]
  emails          EmailLog[]
  createdAt       DateTime         @default(now())

  @@unique([fy, seq])
  @@index([invoiceId])
}

model CreditNoteLine {
  id            String       @id @default(cuid())
  creditNoteId  String
  creditNote    CreditNote   @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  invoiceLineId String? // the invoice line this credits
  invoiceLine   InvoiceLine? @relation(fields: [invoiceLineId], references: [id], onDelete: SetNull)
  position      Int
  description   String
  sac           String?
  quantity      Decimal      @db.Decimal(10, 2)
  unitPrice     Decimal      @db.Decimal(12, 2)
  gstRate       Decimal      @default(0) @db.Decimal(5, 2)
  amount        Decimal      @db.Decimal(14, 2) // before tax

  @@index([creditNoteId])
  @@index([invoiceLineId])
}

// ─── Quotations ────────────────────────────────────────────────────────────
// Price quotes to schools, usually from a CRM deal. Same GST maths as invoices.
// An accepted quote wins the deal and is billed through one or more invoices.

enum QuoteStatus {
  DRAFT // being prepared, no number yet
  SENT // numbered and given to the school, waiting for an answer (expired once past validUntil)
  ACCEPTED
  DECLINED
  REVISED // replaced by a newer quote that was sent
}

model Quote {
  id             String       @id @default(cuid())
  fy             String? // financial year of the quote date, "26-27"
  seq            Int?
  number         String?      @unique // EBG/Q/26-27/001, given when sent
  status         QuoteStatus  @default(DRAFT)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  contactId      String?
  contact        Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  dealId         String?
  deal           Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)
  revisionOfId   String? // the earlier quote this one replaces
  revisionOf     Quote?       @relation("QuoteRevision", fields: [revisionOfId], references: [id], onDelete: SetNull)
  revisions      Quote[]      @relation("QuoteRevision")
  billToName     String
  billToAddress  String?
  billToGstin    String?
  placeOfSupply  String
  quoteDate      DateTime     @db.Date
  validUntil     DateTime     @db.Date
  subtotal       Decimal      @db.Decimal(14, 2) // before GST; becomes the deal value when accepted
  cgst           Decimal      @default(0) @db.Decimal(14, 2)
  sgst           Decimal      @default(0) @db.Decimal(14, 2)
  igst           Decimal      @default(0) @db.Decimal(14, 2)
  total          Decimal      @db.Decimal(14, 2)
  terms          String? // payment and delivery terms printed on the quote
  notes          String?
  sentAt         DateTime?
  decidedOn      DateTime?    @db.Date // when the school accepted or declined
  declineReason  String?
  createdById    String
  createdBy      User         @relation("QuoteCreator", fields: [createdById], references: [id])
  lines          QuoteLine[]
  invoices       Invoice[]
  emails         EmailLog[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([fy, seq])
  @@index([organizationId])
  @@index([dealId])
  @@index([status, validUntil])
}

model QuoteLine {
  id          String  @id @default(cuid())
  quoteId     String
  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  position    Int
  description String
  sac         String?
  quantity    Decimal @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(12, 2)
  gstRate     Decimal @default(0) @db.Decimal(5, 2)
  amount      Decimal @db.Decimal(14, 2) // quantity × unit price, before tax

  @@index([quoteId])
}

// ─── Purchases ─────────────────────────────────────────────────────────────
// Buying from suppliers: vendors, purchase orders approved in the Approvals inbox,
// goods received into stock, the vendor's bill and what has been paid on it.

model Vendor {
  id          String          @id @default(cuid())
  name        String          @unique
  contactName String?
  phone       String?
  email       String?
  address     String?
  state       String          @default("Kerala") // decides CGST + SGST or IGST
  gstin       String?
  pan         String?
  paymentDays Int             @default(30) // bill due this many days after the bill date
  bankDetails String? // account, IFSC or UPI ID, for paying them
  notes       String?
  active      Boolean         @default(true)
  orders      PurchaseOrder[]
  bills       VendorBill[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

enum PurchaseOrderStatus {
  PENDING // waiting for approval
  APPROVED // approved, not yet sent to the vendor
  ORDERED // sent to the vendor, waiting for delivery
  PART_RECEIVED
  RECEIVED // everything arrived
  CLOSED // closed with some lines short
  REJECTED
  CANCELLED
}

model PurchaseOrder {
  id           String              @id @default(cuid())
  number       Int                 @unique @default(autoincrement()) // shown as PO-0001
  vendorId     String
  vendor       Vendor              @relation(fields: [vendorId], references: [id])
  requesterId  String
  requester    User                @relation("PORequester", fields: [requesterId], references: [id])
  projectId    String?
  project      Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  purpose      String
  expectedBy   DateTime?           @db.Date
  interState   Boolean             @default(false) // vendor outside Kerala: IGST instead of CGST + SGST
  subtotal     Decimal             @db.Decimal(12, 2) // before GST
  tax          Decimal             @db.Decimal(12, 2)
  total        Decimal             @db.Decimal(12, 2)
  status       PurchaseOrderStatus @default(PENDING)
  decidedById  String?
  decidedBy    User?               @relation("POApprover", fields: [decidedById], references: [id])
  decidedAt    DateTime?
  decisionNote String?
  orderedAt    DateTime?
  closedAt     DateTime?
  lines        PurchaseOrderLine[]
  receipts     PurchaseReceipt[]
  bills        VendorBill[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([status])
  @@index([vendorId])
}

/// One thing bought. Linked to a stock item when it goes into inventory; free text for anything else.
model PurchaseOrderLine {
  id          String                @id @default(cuid())
  orderId     String
  order       PurchaseOrder         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId      String?
  item        StockItem?            @relation(fields: [itemId], references: [id])
  description String
  quantity    Int
  unit        String                @default("pcs")
  unitPrice   Decimal               @db.Decimal(12, 2) // before GST
  gstRate     Int                   @default(18)
  received    Int                   @default(0)
  receipts    PurchaseReceiptLine[]
}

/// A delivery from the vendor (goods received note). Stock items go into inventory.
model PurchaseReceipt {
  id         String                @id @default(cuid())
  orderId    String
  order      PurchaseOrder         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  receivedOn DateTime              @db.Date
  note       String?
  byId       String
  by         User                  @relation(fields: [byId], references: [id])
  lines      PurchaseReceiptLine[]
  movements  StockMovement[]
  createdAt  DateTime              @default(now())
}

model PurchaseReceiptLine {
  id        String            @id @default(cuid())
  receiptId String
  receipt   PurchaseReceipt   @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  lineId    String
  line      PurchaseOrderLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  quantity  Int
}

enum VendorBillStatus {
  OPEN
  CANCELLED
}

/// The vendor's invoice to us. Paid in one or more payments; what's left shows under Payables.
model VendorBill {
  id        String           @id @default(cuid())
  vendorId  String
  vendor    Vendor           @relation(fields: [vendorId], references: [id])
  orderId   String?
  order     PurchaseOrder?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  billNo    String // the vendor's invoice number
  billDate  DateTime         @db.Date
  dueDate   DateTime         @db.Date
  subtotal  Decimal          @db.Decimal(12, 2)
  tax       Decimal          @db.Decimal(12, 2) // GST on the bill (input credit)
  total     Decimal          @db.Decimal(12, 2)
  notes     String?
  status    VendorBillStatus @default(OPEN)
  byId      String
  by        User             @relation(fields: [byId], references: [id])
  file      VendorBillFile?
  payments  VendorPayment[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([vendorId, billNo])
  @@index([dueDate])
}

/// Photo or PDF of the vendor's bill, kept apart so lists don't load the bytes.
model VendorBillFile {
  id       String     @id @default(cuid())
  billId   String     @unique
  bill     VendorBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  fileName String
  mimeType String
  size     Int
  data     Bytes
}

model VendorPayment {
  id        String     @id @default(cuid())
  billId    String
  bill      VendorBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  paidOn    DateTime   @db.Date
  amount    Decimal    @db.Decimal(12, 2) // money sent
  tds       Decimal    @default(0) @db.Decimal(12, 2) // income tax held back and paid to the government
  method    String // BANK_TRANSFER, UPI, CHEQUE, CASH, OTHER
  reference String? // UTR, cheque number
  note      String?
  byId      String
  by        User       @relation(fields: [byId], references: [id])
  createdAt DateTime   @default(now())

  @@index([billId])
}

// ─── Recruitment ───────────────────────────────────────────────────────────

enum JobStatus {
  OPEN
  ON_HOLD
  FILLED // every opening has a hire
  CLOSED // stopped without filling
}

model JobOpening {
  id              String         @id @default(cuid())
  title           String // Robotics Trainer, Sales Executive…
  departmentId    String?
  department      Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  employmentType  EmploymentType @default(FULL_TIME)
  location        String?        @default("Kochi")
  positions       Int            @default(1) // how many people to hire
  salaryRange     String? // shown to the team only, e.g. "₹18,000–25,000 a month"
  description     String?
  status          JobStatus      @default(OPEN)
  hiringManagerId String?
  hiringManager   User?          @relation("JobHiringManager", fields: [hiringManagerId], references: [id], onDelete: SetNull)
  createdById     String
  createdBy       User           @relation("JobCreator", fields: [createdById], references: [id])
  closedAt        DateTime?
  candidates      Candidate[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status])
}

enum CandidateStage {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
  WITHDRAWN // the candidate pulled out
}

model Candidate {
  id              String          @id @default(cuid())
  jobId           String
  job             JobOpening      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  name            String
  email           String?
  phone           String?
  city            String?
  source          String          @default("Other") // Referral, LinkedIn, Naukri, Walk-in…
  referredBy      String?
  currentRole     String? // current job or course, e.g. "B.Tech ECE, final year"
  experienceYears Decimal?        @db.Decimal(4, 1)
  expectedSalary  Decimal?        @db.Decimal(12, 2) // monthly, INR
  noticePeriod    String?
  notes           String?
  stage           CandidateStage  @default(APPLIED)
  closedReason    String? // why rejected or withdrawn
  employeeId      String?         @unique // set when hired and moved into HR
  employee        Employee?       @relation("HiredAs", fields: [employeeId], references: [id], onDelete: SetNull)
  createdById     String
  createdBy       User            @relation("CandidateCreator", fields: [createdById], references: [id])
  files           CandidateFile[]
  interviews      Interview[]
  offers          Offer[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([jobId, stage])
  @@index([email])
  @@index([phone])
}

/// Resumes and other files, kept in Postgres like employee documents (5 MB cap each).
model CandidateFile {
  id           String    @id @default(cuid())
  candidateId  String
  candidate    Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  kind         String    @default("Resume") // Resume, Portfolio, Certificate, Other
  fileName     String
  mimeType     String
  size         Int
  data         Bytes
  uploadedById String
  uploadedBy   User      @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime  @default(now())

  @@index([candidateId])
}

enum InterviewStatus {
  SCHEDULED
  DONE // feedback given
  CANCELLED
  NO_SHOW
}

enum Recommendation {
  STRONG_YES
  YES
  NO
  STRONG_NO
}

model Interview {
  id             String          @id @default(cuid())
  candidateId    String
  candidate      Candidate       @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  round          String // Phone screen, Technical, Demo class, HR / final
  scheduledAt    DateTime
  mode           String          @default("In person") // In person, Video call, Phone
  location       String? // room, address or meeting link
  interviewerId  String
  interviewer    User            @relation("Interviewer", fields: [interviewerId], references: [id])
  status         InterviewStatus @default(SCHEDULED)
  rating         Int? // 1–5
  recommendation Recommendation?
  feedback       String?
  feedbackAt     DateTime?
  scheduledById  String
  scheduledBy    User            @relation("InterviewScheduler", fields: [scheduledById], references: [id])
  emails         EmailLog[]
  createdAt      DateTime        @default(now())

  @@index([interviewerId, scheduledAt])
  @@index([candidateId])
}

enum OfferStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  WITHDRAWN
}

/// Salary uses the same parts as payroll, so a hire's salary record is filled in from the accepted offer.
model Offer {
  id               String         @id @default(cuid())
  candidateId      String
  candidate        Candidate      @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  designation      String
  departmentId     String?
  department       Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  managerId        String? // who they will report to
  manager          Employee?      @relation("OfferManager", fields: [managerId], references: [id], onDelete: SetNull)
  employmentType   EmploymentType @default(FULL_TIME)
  basic            Decimal        @db.Decimal(12, 2) // monthly
  hra              Decimal        @default(0) @db.Decimal(12, 2)
  specialAllowance Decimal        @default(0) @db.Decimal(12, 2)
  joiningDate      DateTime       @db.Date
  respondBy        DateTime?      @db.Date
  probationMonths  Int            @default(6)
  notes            String? // extra terms printed on the letter
  status           OfferStatus    @default(DRAFT)
  sentAt           DateTime?
  respondedAt      DateTime?
  createdById      String
  createdBy        User           @relation(fields: [createdById], references: [id])
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([candidateId])
}

// ─── Notice board ──────────────────────────────────────────────────────────

enum NoticeKind {
  ANNOUNCEMENT
  POLICY
}

/// A company announcement or policy posted by an admin or manager. Everyone with a login can read it.
model Notice {
  id          String      @id @default(cuid())
  kind        NoticeKind
  title       String
  body        String
  category    String? // policies: Leave, Conduct, Travel…
  pinned      Boolean     @default(false)
  requiresAck Boolean     @default(false)
  ackDueDate  DateTime?   @db.Date
  showUntil   DateTime?   @db.Date // announcements drop off Home after this day
  /// Bumped when a policy changes and everyone must acknowledge again; older acknowledgements stop counting.
  version     Int         @default(1)
  authorId    String
  author      User        @relation(fields: [authorId], references: [id])
  attachment  NoticeFile?
  acks        NoticeAck[]
  archivedAt  DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([kind, archivedAt])
}

/// The policy document or poster attached to a notice (PDF or image, up to 5 MB).
model NoticeFile {
  id       String @id @default(cuid())
  noticeId String @unique
  notice   Notice @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  fileName String
  mimeType String
  size     Int
  data     Bytes
}

model NoticeAck {
  id       String   @id @default(cuid())
  noticeId String
  notice   Notice   @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  version  Int // the notice version that was acknowledged
  ackedAt  DateTime @default(now())

  @@unique([noticeId, userId])
}

// ─── Helpdesk ──────────────────────────────────────────────────────────────

enum TicketStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED // withdrawn by the person who raised it
}

/// A request from any staff member to the admin team: equipment, ID card, repairs, letters…
model HelpdeskTicket {
  id              String               @id @default(cuid())
  number          Int                  @unique @default(autoincrement()) // shown as HD-001
  title           String
  description     String
  category        String // see HELPDESK_CATEGORIES
  priority        Priority             @default(MEDIUM)
  status          TicketStatus         @default(OPEN)
  requesterId     String
  requester       User                 @relation("TicketRequester", fields: [requesterId], references: [id])
  assigneeId      String?
  assignee        User?                @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assetId         String? // the laptop, kit or card this is about, from HR Assets
  asset           Asset?               @relation(fields: [assetId], references: [id], onDelete: SetNull)
  resolution      String? // what was done, written when it is marked done
  doneAt          DateTime?
  requesterUnread Boolean              @default(false) // someone else changed it since the requester last looked
  comments        HelpdeskComment[]
  attachments     HelpdeskAttachment[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([requesterId, status])
  @@index([status, assigneeId])
}

/// A reply on a request, or a line in its history ("Moved to In progress").
model HelpdeskComment {
  id        String         @id @default(cuid())
  ticketId  String
  ticket    HelpdeskTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  author    User           @relation(fields: [authorId], references: [id])
  body      String?
  event     String? // system note, e.g. "Assigned to Anu" or "Marked done"
  createdAt DateTime       @default(now())

  attachments HelpdeskAttachment[]

  @@index([ticketId, createdAt])
}

/// Photos and PDFs on a request, stored in Postgres like employee documents (5 MB each).
model HelpdeskAttachment {
  id           String           @id @default(cuid())
  ticketId     String
  ticket       HelpdeskTicket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  commentId    String?
  comment      HelpdeskComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  fileName     String
  mimeType     String
  size         Int
  data         Bytes
  uploadedById String
  uploadedBy   User             @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime         @default(now())

  @@index([ticketId])
}

// ─── Emails ────────────────────────────────────────────────────────────────
// Every email the app sends, sent or failed, so each invoice, quote, payslip and interview shows its history.

enum EmailKind {
  TEST
  INVOICE
  PAYMENT_REMINDER
  QUOTE
  PAYSLIP
  INTERVIEW_INVITE
  CREDIT_NOTE
}

enum EmailStatus {
  SENT
  FAILED
}

model EmailLog {
  id           String      @id @default(cuid())
  kind         EmailKind
  status       EmailStatus
  to           String // comma-separated
  cc           String?
  subject      String
  attachments  String[] // file names, e.g. "Invoice EBG-26-27-001.pdf"
  error        String? // why it failed, as the mail server said
  invoices     Invoice[] // one for an invoice email, every unpaid one for a school's reminder
  quoteId      String?
  quote        Quote?      @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  payslipId    String?
  payslip      Payslip?    @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  interviewId  String?
  interview    Interview?  @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  creditNoteId String?
  creditNote   CreditNote? @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  sentById     String
  sentBy       User        @relation(fields: [sentById], references: [id])
  createdAt    DateTime    @default(now())

  @@index([kind, createdAt])
  @@index([quoteId])
  @@index([payslipId])
  @@index([interviewId])
  @@index([creditNoteId])
}

// ---------- Daily checklists ----------

enum ChecklistFrequency {
  DAILY // every working day (Admin > Settings weekly offs and holidays skipped)
  WEEKLY // once a week, due on `weekday`
  MONTHLY // once a month, due on `dayOfMonth` (0 = last working day)
  SESSION // before each school session, for its trainer
}

enum ChecklistAudience {
  EVERYONE
  ROLE
  PEOPLE
}

model ChecklistTemplate {
  id          String              @id @default(cuid())
  title       String
  description String?
  frequency   ChecklistFrequency
  weekday     Int? // WEEKLY: 0 = Sunday … 6 = Saturday
  dayOfMonth  Int? // MONTHLY: 1-28, or 0 for the last working day
  dueTime     String? // "10:00" India time; end of day when empty. SESSION: the class start time
  audience    ChecklistAudience   @default(PEOPLE) // who it's for (SESSION: always the session's trainer)
  role        Role? // when audience is ROLE
  startsOn    DateTime            @db.Date // nothing before this counts as missed
  endsOn      DateTime?           @db.Date // switched off: nothing after this is due, history stays
  createdById String
  createdBy   User                @relation(fields: [createdById], references: [id])
  items       ChecklistItem[]
  assignees   ChecklistAssignee[]
  runs        ChecklistRun[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model ChecklistItem {
  id         String            @id @default(cuid())
  templateId String
  template   ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  label      String
  needsPhoto Boolean           @default(false)
  position   Int
  archivedAt DateTime? // removed from the list but kept for past ticks
  ticks      ChecklistTick[]

  @@index([templateId])
}

model ChecklistAssignee {
  templateId String
  template   ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([templateId, userId])
}

/// One person's copy of a checklist for one day, week, month or school session. Created on the first tick.
model ChecklistRun {
  id          String            @id @default(cuid())
  templateId  String
  template    ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  userId      String
  user        User              @relation("ChecklistRunner", fields: [userId], references: [id], onDelete: Cascade)
  periodKey   String // "2026-10-07", or "session:<id>"
  dueDate     DateTime          @db.Date
  sessionId   String?
  session     ProgrammeSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  completedAt DateTime?
  ticks       ChecklistTick[]
  createdAt   DateTime          @default(now())

  @@unique([templateId, userId, periodKey])
  @@index([userId, dueDate])
  @@index([dueDate])
}

model ChecklistTick {
  id         String          @id @default(cuid())
  runId      String
  run        ChecklistRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  itemId     String
  item       ChecklistItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  note       String?
  tickedById String
  tickedBy   User            @relation(fields: [tickedById], references: [id])
  tickedAt   DateTime        @default(now())
  photo      ChecklistPhoto?

  @@unique([runId, itemId])
}

model ChecklistPhoto {
  id       String        @id @default(cuid())
  tickId   String        @unique
  tick     ChecklistTick @relation(fields: [tickId], references: [id], onDelete: Cascade)
  fileName String
  mimeType String
  size     Int
  data     Bytes
}
