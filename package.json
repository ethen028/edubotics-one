{
  "name": "edubotics-one",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "security:secrets": "node scripts/check-secrets.mjs",
    "security:dependencies": "node scripts/check-dependencies.mjs",
    "test": "tsx --test tests/*.test.ts",
    "test:smoke": "node --env-file=.env --import tsx scripts/smoke-test.ts",
    "test:workflows": "node --env-file=.env --import tsx scripts/hr-inventory-smoke.ts",
    "test:acceptance": "node --env-file=.env --import tsx scripts/acceptance-test.ts",
    "test:security": "node --conditions=react-server --env-file-if-exists=.env --import tsx scripts/security-integration.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed-demo": "tsx scripts/seed-demo.ts",
    "demo:seed": "tsx scripts/seed-demo.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@react-pdf/renderer": "^4.9.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.12",
    "next": "16.3.8",
    "nodemailer": "^10.0.15",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.0"
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
